# LM Studio Configuration
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
LLM_TEMPERATURE=0

# MSSQL Database Connection
# Format: mssql+pyodbc://user:password@server/database?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/YourDatabase?driver=ODBC+Driver+17+for+SQL+Server

# Agent Configuration
MAX_RETRY_ATTEMPTS=3
QUERY_TIMEOUT_SECONDS=30

# SQL Query Configuration
DEFAULT_RESULT_LIMIT=10
MAX_RESULT_LIMIT=50

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seq Logging (optional)
SEQ_SERVER_URL=http://seq:5341
SEQ_API_KEY=

# Langfuse Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_BASE_URL=http://langfuse:3000

# Langfuse Admin (required if LANGFUSE_ENABLED=true)
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_PASSWORD=change-me-strong-password

# Langfuse Internal Secrets (generate with: openssl rand -hex 32)
LANGFUSE_SALT=replace-with-32-plus-char-random-string
LANGFUSE_ENCRYPTION_KEY=replace-with-64-char-hex-string-generated-by-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=replace-with-32-plus-char-random-string

# Redis (reuses langfuse-redis by default in docker-compose)
REDIS_URL=redis://:langfuseredis@localhost:6379/1

# Conversational Memory
CONVERSATION_MEMORY_LIMIT=5
SESSION_TTL_MINUTES=60
